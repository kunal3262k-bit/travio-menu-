DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dineflow?schema=public"
JWT_SECRET="replace-with-a-strong-32-byte-secret"
APP_URL="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"

# Web Push (staff background notifications) — VAPID keypair.
# Generate with: npx web-push generate-vapid-keys --json
# VAPID_SUBJECT must be "mailto:you@example.com" or an https:// URL.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"
