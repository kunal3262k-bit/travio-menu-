generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  KITCHEN
  WAITER
}

enum RestaurantStatus {
  SETUP
  LIVE
  PAUSED
  CLOSED
  TEMPORARILY_BUSY
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum RequestType {
  CALL_WAITER
  REQUEST_BILL
}

enum RequestStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Restaurant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  logoUrl        String?
  currency       String           @default("INR")
  serviceEnabled Boolean          @default(true)
  status         RestaurantStatus @default(SETUP)
  invoiceCounter Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Branding & Profile
  coverImage      String?
  brandColor      String?          @default("#000000")
  phone           String?
  whatsappPhone   String?
  address         String?
  gstNumber       String?
  googleReviewUrl String?
  reviewRedirectThreshold Int      @default(4)
  upiQrUrl        String?
  cuisine         String?
  isVegOnly       Boolean          @default(false)
  instagramUrl    String?
  facebookUrl     String?
  websiteUrl      String?

  settings        Json             @default("{}")
  users           User[]
  staff           Staff[]
  pushSubscriptions PushSubscription[]
  tables         Table[]
  categories     Category[]
  menuItems      MenuItem[]
  orders         Order[]
  customers      Customer[]
  upsellRules    UpsellRule[]
  waiterRequests WaiterRequest[]
  tableScans     TableScan[]
  feedbacks      Feedback[]
}

model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  pinHash      String
  role         UserRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([restaurantId, role, active])
}

model Feedback {
  id             String     @id @default(cuid())
  restaurantId   String
  rating         Int
  comment        String?
  customerPhone  String?
  tableNumber    Int?
  routedToGoogle Boolean    @default(false)
  createdAt      DateTime   @default(now())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  email        String
  name         String
  passwordHash String
  role         UserRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@index([restaurantId, role])
}

model Table {
  id           String     @id @default(cuid())
  restaurantId String
  number       Int
  label        String?
  active       Boolean    @default(true)
  qrToken      String     @unique @default(cuid())
  currentSessionId String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  requests     WaiterRequest[]
  tableScans   TableScan[]

  @@unique([restaurantId, number])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id             String       @id @default(cuid())
  restaurantId   String
  categoryId     String
  name           String
  description    String?
  imageUrl       String?
  imageSource    String?      @default("AI_GENERATED")
  imageGallery   Json?        @default("[]")
  aiPrompt       String?
  calories       Int?
  proteinGrams   Float?
  fatGrams       Float?
  carbsGrams     Float?
  fiberGrams     Float?
  allergens      Json?        @default("[]")
  dietaryFlags   Json?        @default("[]")
  chefNote       String?
  isPopular      Boolean      @default(false)
  isHotSizzler   Boolean      @default(false)
  pricePaise     Int
  foodType       FoodType
  spicyLevel     Int          @default(0)
  available      Boolean      @default(true)
  active         Boolean      @default(true)
  preparationMin Int          @default(12)
  sortOrder      Int          @default(0)
  needsReview    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  triggerRules   UpsellRule[] @relation("UpsellTrigger")
  suggestedBy    UpsellRule[] @relation("UpsellSuggestion")

  @@index([restaurantId, categoryId, available])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  phone        String?
  displayName  String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId, phone])
}

enum SessionType {
  TABLE
  CAR
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  UNPAID
  CLAIMED
  PAID
}

model Order {
  id               String        @id @default(cuid())
  restaurantId     String
  tableId          String?
  tableSessionId   String?
  sessionType      SessionType   @default(TABLE)
  customerId       String?
  orderNumber      Int
  // OPERATIONAL VS TAX INVOICING NUMBERS:
  // - dailyOrderNumber: Operational order # (e.g. #1, #2...) displayed on Kitchen KDS / Waiter Panel. Resets daily.
  // - orderNumber: Global sequential order counter per restaurant in DB.
  // - invoiceNumber: GST-compliant tax invoice sequence per restaurant (e.g. 1001, 1002...). Continuous, does NOT reset daily.
  dailyOrderNumber Int           @default(1)
  invoiceNumber    Int?
  printCount       Int           @default(0)
  lastPrintedAt    DateTime?
  carBrand         String?
  carColor         String?
  carLicensePlate  String?
  carOrderType     String?       @default("EAT_IN_CAR")
  customerName     String?
  customerPhone    String?
  status           OrderStatus   @default(RECEIVED)
  paymentMethod    PaymentMethod?
  paymentStatus    PaymentStatus @default(UNPAID)
  subtotalPaise    Int
  taxPaise         Int           @default(0)
  totalPaise       Int           @default(0)
  instructions     String?
  estimatedReadyAt DateTime?
  idempotencyKey   String?
  processedByStaffId   String?
  processedByStaffName String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table            Table?        @relation(fields: [tableId], references: [id])
  customer         Customer?     @relation(fields: [customerId], references: [id])
  items            OrderItem[]

  @@unique([restaurantId, orderNumber])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, tableSessionId])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  nameSnapshot  String
  pricePaise    Int
  quantity      Int
  instructions  String?
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
}

model UpsellRule {
  id                    String     @id @default(cuid())
  restaurantId          String
  triggerMenuItemId     String
  recommendedMenuItemId String
  active                Boolean    @default(true)
  priority              Int        @default(0)
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  triggerMenuItem       MenuItem   @relation("UpsellTrigger", fields: [triggerMenuItemId], references: [id])
  recommendedMenuItem   MenuItem   @relation("UpsellSuggestion", fields: [recommendedMenuItemId], references: [id])

  @@unique([restaurantId, triggerMenuItemId, recommendedMenuItemId])
  @@index([restaurantId, active, priority])
}

model WaiterRequest {
  id           String        @id @default(cuid())
  restaurantId String
  tableId      String
  type         RequestType
  status       RequestStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table         @relation(fields: [tableId], references: [id])

  @@index([restaurantId, status, createdAt])
}

model TableScan {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tableId      String
  table        Table      @relation(fields: [tableId], references: [id])
  createdAt    DateTime   @default(now())
}

model PushSubscription {
  id             String   @id @default(cuid())
  restaurantId   String
  restaurantSlug String
  staffId        String
  role           UserRole
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([restaurantId, role])
  @@index([staffId])
}